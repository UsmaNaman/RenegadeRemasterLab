#!/bin/sh
# Inspect the entire ancestry, including commits newly exposed by a tag.
set -eu
export GIT_NO_REPLACE_OBJECTS=1
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    commit=$(git rev-parse --verify "$local_oid^{commit}") || exit 1
    emails=$(git log --format='%ae%n%ce' "$commit") || exit 1
    if printf '%s\n' "$emails" | grep -Evq '^[^@[:space:]<>]+@users\.noreply\.github\.com$'; then
        echo "Push refused: $local_ref contains a private author or committer identity." >&2
        exit 1
    fi
done
