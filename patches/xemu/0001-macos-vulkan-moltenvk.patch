+    } else {
+        mstring_append(clip, "float tri_mz = triMZ;\n");
+    }
     mstring_append_fmt(clip, "/*  Window-clip (%slusive) */\n",
                        ps->state->window_clip_exclusive ? "Exc" : "Inc");
     if (!ps->state->window_clip_exclusive) {
@@ -1023,6 +1038,9 @@ static MString* psh_convert(struct PixelShader *ps)
     }
 
     if (ps->state->z_perspective) {
+        if (ps->opts.no_geom) {
+            mstring_append(clip, "precise float zvalue = 1.0 / zsrc;\n");
+        } else {
         mstring_append(
             clip,
             "vec2 unscaled_xy = gl_FragCoord.xy / surfaceScale;\n"
@@ -1040,14 +1058,17 @@ static MString* psh_convert(struct PixelShader *ps)
             "}\n"
