+/*
+ * Without geometry shaders (Metal/MoltenVK) quads can't be drawn as
+ * lines-with-adjacency, so expand them into triangle-list indices, using the
+ * same vertex order the geometry shader emits. src NULL means sequential
+ * vertices starting at first. Returns NULL when no expansion is needed.
+ */
+static GArray *expand_quads(PGRAPHState *pg, GArray *out, const uint32_t *src,
+                            uint32_t first, uint32_t count)
+{
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    /* shader_binding isn't bound for this draw yet; use the live state */
+    int mode = pg->primitive_mode;
+
+    if (r->enabled_physical_device_features.geometryShader ||
+        (mode != PRIM_TYPE_QUADS && mode != PRIM_TYPE_QUAD_STRIP)) {
+        return out;
+    }
+    if (!out) {
+        out = g_array_new(FALSE, FALSE, sizeof(uint32_t));
+    }
+
+#define IDX(i) (src ? src[i] : first + (i))
+    uint32_t step = mode == PRIM_TYPE_QUADS ? 4 : 2;
+    for (uint32_t i = 0; i + 3 < count; i += step) {
+        uint32_t t[6];
+        if (mode == PRIM_TYPE_QUADS) {
+            uint32_t q[6] = { IDX(i), IDX(i + 1), IDX(i + 2),
+                              IDX(i), IDX(i + 2), IDX(i + 3) };
+            memcpy(t, q, sizeof(t));
+        } else {
+            uint32_t q[6] = { IDX(i),     IDX(i + 1), IDX(i + 2),
+                              IDX(i + 2), IDX(i + 1), IDX(i + 3) };
+            memcpy(t, q, sizeof(t));
+        }
+        g_array_append_vals(out, t, 6);
+    }
+#undef IDX
+
+    return out;
+}
+
+static void draw_indexed(PGRAPHState *pg, VkDeviceSize offset,
+                                uint32_t count)
+{
+    PGRAPHVkState *r = pg->vk_renderer_state;
+
+    vkCmdBindIndexBuffer(r->command_buffer,
+                         r->storage_buffers[BUFFER_INDEX].buffer, offset,
+                         VK_INDEX_TYPE_UINT32);
+    vkCmdDrawIndexed(r->command_buffer, count, 1, 0, 0, 0);
+}
