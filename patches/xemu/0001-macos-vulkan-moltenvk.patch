diff --git a/rebuild-mac-vulkan.sh b/rebuild-mac-vulkan.sh
new file mode 100755
index 0000000..4ddba7d
--- /dev/null
+++ b/rebuild-mac-vulkan.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+# Rebuild the macOS Vulkan xemu into dist/xemu.app (run ./build.sh once first).
+set -euo pipefail
+cd "$(dirname "$0")"
+
+make -j"$(sysctl -n hw.ncpu)" qemu-system-i386
+
+# Reuse build.sh's packaging; its last step (license file) needs a pkg-config
+# setup we don't have, so tolerate that one failure.
+pkg=$(mktemp)
+awk '/^package_macos\(\) *\{/{f=1} f{print} f&&/^}/{exit}' build.sh > "$pkg"
+printf 'target_arch=arm64\nproject_source_dir=%s\npackage_macos\n' "$PWD" >> "$pkg"
+bash "$pkg" || true
+rm -f "$pkg"
+
+app=dist/xemu.app
+exe=$app/Contents/MacOS/xemu
+# dylibbundler adds an rpath the binary already has; new dyld refuses duplicates
+rp='@executable_path/../Libraries/arm64/'
+while [ "$(otool -l "$exe" | grep -c "path $rp")" -gt 1 ]; do
+    install_name_tool -delete_rpath "$rp" "$exe"
+done
+
+mkdir -p $app/Contents/Frameworks
+cp /opt/homebrew/opt/molten-vk/lib/libMoltenVK.dylib $app/Contents/Frameworks/
+codesign --force --deep -s - $app
+echo "Built $app"
