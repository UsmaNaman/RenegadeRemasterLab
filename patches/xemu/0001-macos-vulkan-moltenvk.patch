@@ -1071,9 +1095,10 @@ static MString* psh_convert(struct PixelShader *ps)
             "}\n"
             "bc1 *= inv_bcsum;\n"
             "bc2 *= inv_bcsum;\n"
-            "precise float zvalue = vtxPos0.z + (bc1*(vtxPos1.z - vtxPos0.z) + bc2*(vtxPos2.z - vtxPos0.z));\n"
-            "zvalue += depthOffset;\n"
-            "zvalue += depthFactor*triMZ;\n");
+            "precise float zvalue = vtxPos0.z + (bc1*(vtxPos1.z - vtxPos0.z) + bc2*(vtxPos2.z - vtxPos0.z));\n");
+        }
