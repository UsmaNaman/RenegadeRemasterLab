+/*
+ * RRL texture pack: $XEMU_TEXTURE_PACK_DIR/<content hash>.rgba replaces the
+ * guest texture with that hash. File: "RRT1", then little-endian u32 width,
+ * height and levels, then each level's R8G8B8A8 pixels, tightly packed, level
+ * sizes halving with a floor of 1. The size must be the guest size times a
+ * power of two (1 included) on both axes.
+ */
+typedef struct PackTexture {
+    uint32_t width, height, levels, shift;
+    size_t size;
+    uint8_t *data; /* points into file */
+    gchar *file;
+} PackTexture;
+
+static GHashTable *pack_index(void)
+{
+    static GHashTable *index; /* hash -> GINT_TO_POINTER(1) */
+    static bool loaded;
+
+    if (loaded) {
+        return index;
+    }
+    loaded = true;
+    const char *dir = g_getenv("XEMU_TEXTURE_PACK_DIR");
+    if (!dir) {
+        return NULL;
+    }
+    g_autoptr(GDir) d = g_dir_open(dir, 0, NULL);
+    if (!d) {
+        fprintf(stderr, "xemu: texture pack: cannot open %s\n", dir);
+        return NULL;
+    }
+    index = g_hash_table_new(g_direct_hash, g_direct_equal);
+    const char *name;
+    while ((name = g_dir_read_name(d))) {
+        char *end;
+        guint64 hash = g_ascii_strtoull(name, &end, 16);
+        if (end == name + 16 && !strcmp(end, ".rgba")) {
+            /* 64-bit hosts only, as in dump_texture */
+            g_hash_table_add(index, (gpointer)(uintptr_t)hash);
+        }
+    }
+    fprintf(stderr, "xemu: texture pack: %u textures in %s\n",
+            g_hash_table_size(index), dir);
+    return index;
+}
+
+static bool pack_has(uint64_t hash)
+{
+    GHashTable *index = pack_index();
+    return index && g_hash_table_contains(index, (gpointer)(uintptr_t)hash);
+}
+
+static void pack_texture_free(PackTexture *t)
+{
+    if (t) {
+        g_free(t->file);
+        g_free(t);
+    }
+}
+
+/* NULL (after one message; the hash is then forgotten) if the file is bad */
+static PackTexture *pack_load(uint64_t hash, const TextureShape *s,
+                              size_t staging_size)
+{
+    PackTexture *t = g_new0(PackTexture, 1);
+    gsize len = 0;
+    const char *err = NULL;
+    g_autofree gchar *path = g_strdup_printf(
+        "%s/%016" PRIx64 ".rgba", g_getenv("XEMU_TEXTURE_PACK_DIR"), hash);
+
+    /* shortcut: re-read from disk on every (re)creation; cache if it shows up in profiles */
+    if (!g_file_get_contents(path, &t->file, &len, NULL)) {
+        err = "unreadable";
+    } else if (len < 16 || memcmp(t->file, "RRT1", 4)) {
+        err = "bad header";
+    } else {
+        memcpy(&t->width, t->file + 4, 4);
+        memcpy(&t->height, t->file + 8, 4);
+        memcpy(&t->levels, t->file + 12, 4);
+        t->width = le32_to_cpu(t->width);
+        t->height = le32_to_cpu(t->height);
+        t->levels = le32_to_cpu(t->levels);
+        while (t->shift < 8 && (s->width << t->shift) < t->width) {
+            t->shift++;
+        }
+        for (uint32_t l = 0; l < t->levels && l < 16; l++) {
+            t->size += (size_t)MAX(1, t->width >> l) * MAX(1, t->height >> l) * 4;
+        }
+        if (t->levels < 1 || t->levels > 16 ||
+            t->width != s->width << t->shift ||
+            t->height != s->height << t->shift) {
+            err = "size is not the guest size times a power of two";
+        } else if (len != 16 + t->size) {
+            err = "length does not match its levels";
+        } else if (t->size > staging_size) {
+            err = "larger than the staging buffer";
+        }
+    }
+    if (err) {
+        fprintf(stderr, "xemu: texture pack: %s: %s, ignored\n", path, err);
+        g_hash_table_remove(pack_index(), (gpointer)(uintptr_t)hash);
+        pack_texture_free(t);
+        return NULL;
+    }
+    t->data = (uint8_t *)t->file + 16;
+    return t;
+}
+
+static void upload_pack_texture(PGRAPHState *pg, TextureBinding *binding,
+                                const PackTexture *t)
+{
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    uint8_t *mapped;
+
+    VK_CHECK(vmaMapMemory(r->allocator,
+                          r->storage_buffers[BUFFER_STAGING_SRC].allocation,
+                          (void *)&mapped));
+    memcpy(mapped, t->data, t->size);
+
+    g_autofree VkBufferImageCopy *regions =
+        g_malloc0_n(t->levels, sizeof(VkBufferImageCopy));
+    VkDeviceSize offset = 0;
+    for (uint32_t l = 0; l < t->levels; l++) {
+        uint32_t w = MAX(1, t->width >> l), h = MAX(1, t->height >> l);
+        regions[l] = (VkBufferImageCopy){
+            .bufferOffset = offset,
+            .imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+            .imageSubresource.mipLevel = l,
+            .imageSubresource.layerCount = 1,
+            .imageExtent = (VkExtent3D){ w, h, 1 },
+        };
+        offset += (VkDeviceSize)w * h * 4;
+    }
+    copy_staging_to_image(pg, binding, VK_FORMAT_R8G8B8A8_UNORM, regions,
+                          t->levels);
+}
+
 static void create_texture(PGRAPHState *pg, int texture_idx)
 {
     NV2A_VK_DGROUP_BEGIN("Creating texture %d", texture_idx);
@@ -1244,6 +1393,20 @@ static void create_texture(PGRAPHState *pg, int texture_idx)
                      content_hash, raw_hash);
     }
 
+    bool want_pack = content_hash && !f_basic.linear && !is_indexed &&
+                     !state.cubemap && state.dimensionality == 2 &&
+                     pack_has(content_hash);
+    if (binding_found && !surface_to_texture &&
+        (snode->draw_time || (possibly_dirty && content_hash != snode->hash)) &&
