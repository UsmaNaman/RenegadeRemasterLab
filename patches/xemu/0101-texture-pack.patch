+
     if (binding_found) {
         if (surface_to_texture) {
             if (surface->draw_time != snode->draw_time) {
@@ -1269,6 +1432,12 @@ static void create_texture(PGRAPHState *pg, int texture_idx)
     snode->possibly_dirty = false;
     snode->hash = content_hash;
 
+    PackTexture *pack = want_pack ?
+        pack_load(content_hash, &state,
+                  r->storage_buffers[BUFFER_STAGING_SRC].buffer_size) :
+        NULL;
+    snode->replaced = pack != NULL;
+
     VkColorFormatInfo vkf = kelvin_color_format_vk_map[state.color_format];
     assert(vkf.vk_format != 0);
     assert(0 < state.dimensionality);
@@ -1293,6 +1462,13 @@ static void create_texture(PGRAPHState *pg, int texture_idx)
         .flags = (state.cubemap ? VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT : 0),
     };
 
+    if (pack) {
+        image_create_info.extent.width = pack->width;
+        image_create_info.extent.height = pack->height;
+        image_create_info.mipLevels = pack->levels;
+        image_create_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+    }
+
     if (surface_to_texture) {
         pgraph_apply_scaling_factor(pg, &image_create_info.extent.width,
                                         &image_create_info.extent.height);
@@ -1312,7 +1488,7 @@ static void create_texture(PGRAPHState *pg, int texture_idx)
         .viewType = state.cubemap ?
             VK_IMAGE_VIEW_TYPE_CUBE :
             dimensionality_to_vk_image_view_type[state.dimensionality],
-        .format = vkf.vk_format,
+        .format = image_create_info.format,
         .subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
         .subresourceRange.baseMipLevel = 0,
         .subresourceRange.levelCount = image_create_info.mipLevels,
@@ -1320,6 +1496,10 @@ static void create_texture(PGRAPHState *pg, int texture_idx)
         .subresourceRange.layerCount = image_create_info.arrayLayers,
         .components = vkf.component_map,
     };
+    if (pack) {
+        /* pack pixels are already RGBA as the game meant them */
+        image_view_create_info.components = (VkComponentMapping){ 0 };
+    }
 
     VK_CHECK(vkCreateImageView(r->device, &image_view_create_info, NULL,
                                &snode->image_view));
@@ -1460,6 +1640,16 @@ static void create_texture(PGRAPHState *pg, int texture_idx)
         .pNext = sampler_next_struct,
     };
 
+    if (pack && mipmap_en) {
+        /* guest level n is pack level n + shift; keep the finer ones usable */
+        sampler_create_info.minLod =
+            state.min_mipmap_level ?
+                MIN(state.min_mipmap_level + pack->shift, pack->levels - 1) :
+                0;
+        sampler_create_info.maxLod =
+            MIN(state.max_mipmap_level + pack->shift, pack->levels - 1);
+    }
+
     VK_CHECK(vkCreateSampler(r->device, &sampler_create_info, NULL,
                              &snode->sampler));
 
@@ -1469,10 +1659,14 @@ static void create_texture(PGRAPHState *pg, int texture_idx)
 
     if (surface_to_texture) {
         copy_surface_to_texture(pg, surface, snode);
+    } else if (pack) {
+        upload_pack_texture(pg, snode, pack);
+        snode->draw_time = 0;
     } else {
         upload_texture_image(pg, texture_idx, snode);
         snode->draw_time = 0;
     }
+    pack_texture_free(pack);
 
     NV2A_VK_DGROUP_END();
 }
@@ -1544,6 +1738,7 @@ static void texture_cache_entry_init(Lru *lru, LruNode *node, const void *state)
     snode->draw_time = 0;
     snode->hash = 0;
     snode->possibly_dirty = false;
+    snode->replaced = false;
 }
 
 static void texture_cache_release_node_resources(PGRAPHVkState *r, TextureBinding *snode)
